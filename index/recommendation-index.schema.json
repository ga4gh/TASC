{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ga4gh/TASC/main/index/recommendation-index.schema.json",
  "title": "TASC recommendation index",
  "description": "Index of the recommendations and governance documents in ga4gh/TASC. Generated by tools/tasc_index; do not edit by hand.",
  "type": "object",
  "required": [
    "documents"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "documents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/document"
      }
    }
  },
  "$defs": {
    "recommendationStatus": {
      "description": "Lifecycle status of a recommendation or governance document. Keep in sync with recommendations/template.md.",
      "enum": [
        "Draft",
        "Approved",
        "Superseded"
      ]
    },
    "commonFields": {
      "type": "object",
      "required": [
        "id",
        "type",
        "name",
        "date",
        "status",
        "description",
        "path",
        "url"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Document identifier, e.g. TASC-ADR-001."
        },
        "type": {
          "enum": [
            "adr",
            "recommendation",
            "governance"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Document title."
        },
        "date": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "status": {
          "type": "string"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "description": "One-line summary."
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Repository-relative path to the source file."
        },
        "url": {
          "type": "string",
          "format": "uri",
          "description": "Link to the source file in the TASC repository."
        }
      }
    },
    "document": {
      "oneOf": [
        {
          "$ref": "#/$defs/recommendation"
        },
        {
          "$ref": "#/$defs/governance"
        }
      ]
    },
    "recommendation": {
      "allOf": [
        {
          "$ref": "#/$defs/commonFields"
        }
      ],
      "properties": {
        "id": {
          "pattern": "^GA4GH-REC-\\d{2,}$"
        },
        "type": {
          "const": "recommendation"
        },
        "status": {
          "$ref": "#/$defs/recommendationStatus"
        }
      },
      "unevaluatedProperties": false
    },
    "governance": {
      "allOf": [
        {
          "$ref": "#/$defs/commonFields"
        }
      ],
      "properties": {
        "id": {
          "pattern": "^TASC-GOV-\\d{2,}$"
        },
        "type": {
          "const": "governance"
        },
        "status": {
          "$ref": "#/$defs/recommendationStatus"
        }
      },
      "unevaluatedProperties": false
    }
  }
}
