{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ga4gh/TASC/main/index/adr-index.schema.json",
  "title": "TASC ADR index",
  "description": "Index of the Architectural Decision Records in ga4gh/TASC. Generated by tools/tasc_index; do not edit by hand.",
  "type": "object",
  "required": [
    "documents"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "documents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/adr"
      }
    }
  },
  "$defs": {
    "adrStatus": {
      "description": "Lifecycle status of an ADR. Keep in sync with adr/template.md.",
      "enum": [
        "Draft",
        "Proposed",
        "Accepted",
        "Deprecated",
        "Superseded"
      ]
    },
    "commonFields": {
      "type": "object",
      "required": [
        "id",
        "type",
        "name",
        "date",
        "status",
        "description",
        "path",
        "url"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Document identifier, e.g. TASC-ADR-001."
        },
        "type": {
          "enum": [
            "adr",
            "recommendation",
            "governance"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Document title."
        },
        "date": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "status": {
          "type": "string"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "description": "One-line summary."
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Repository-relative path to the source file."
        },
        "url": {
          "type": "string",
          "format": "uri",
          "description": "Link to the source file in the TASC repository."
        }
      }
    },
    "adr": {
      "allOf": [
        {
          "$ref": "#/$defs/commonFields"
        }
      ],
      "properties": {
        "id": {
          "pattern": "^TASC-ADR-\\d{3,}$"
        },
        "type": {
          "const": "adr"
        },
        "status": {
          "$ref": "#/$defs/adrStatus"
        },
        "short_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "Short title used in listings, e.g. 'Use Crossref for DOI'. Taken from the file name, e.g. 'TASC-ADR-001 Use Crossref for DOI.md'."
        }
      },
      "unevaluatedProperties": false,
      "required": [
        "short_name"
      ]
    }
  }
}
